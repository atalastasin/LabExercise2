<div class="container my-4">

  <!-- Student Info Card -->
  <div class="card mb-4 shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header text-white" style="background-color: #b30000;">
      <h4 class="mb-0 fw-bold"><%= @student.name %></h4>
    </div>
    <div class="card-body bg-light">
      <p class="mb-0"><strong> Year Level:</strong> <%= @student.year_level %></p>
      <p class="mb-0"><strong> Program:</strong> <%= @student.program %></p>
      <p class="mb-0"><strong> Department:</strong> <%= @student.department.name %></p>
      <p class="mb-0"><strong> Number of Units:</strong> <%= @student.number_of_units %></p>
      <p class="mb-0"><strong> Total Assessment:</strong> <%= @student.total_assessment %></p>
    </div>
  </div>

  <!-- Subjects Table -->
  <div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">📚 Enrolled Subjects</h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover mb-0 align-middle text-center">
        <thead class="table-secondary">
          <tr>
            <th>Subject</th>
            <th>Section</th>
            <th>Units</th>
            <th>Teacher</th>
          </tr>
        </thead>
        <tbody>
          <% @student.classlists.each do |classlist| %>
            <tr>
              <td><%= classlist.section.subject.name %></td>
              <td><%= classlist.section.name %></td>
              <td><%= classlist.section.subject.number_of_units %></td>
              <td><%= classlist.section.subject.teacher.name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Buttons -->
  <div class="d-flex justify-content-between align-items-center mt-4">
    <%= link_to "← Back to Students", students_path,
          class: "btn btn-sm d-flex align-items-center gap-2",
          style: "background-color: #6c757d; color: white; border: none; font-weight: 500;" %>

    <div class="d-flex gap-2">
      <%= link_to edit_student_path(@student),
            class: "btn btn-sm d-flex align-items-center gap-2",
            style: 'background-color: #f1c40f; color: #333; border: none; font-weight: 500;' do %>
        <i class="bi bi-pencil-square"></i> Edit
      <% end %>

      <%= button_to @student, method: :delete,
            data: { confirm: "Are you sure you want to delete this student?" },
            class: "btn btn-sm d-flex align-items-center gap-2",
            style: 'background-color: #e74c3c; color: white; border: none; font-weight: 500;' do %>
        <i class="bi bi-trash3"></i> Delete
      <% end %>
    </div>
  </div>

</div>

<!-- Hover Animation -->
<style>
  .btn:hover {
    filter: brightness(90%);
    transform: translateY(-1px);
    transition: 0.3s;
  }
</style>
